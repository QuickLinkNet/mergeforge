RewriteEngine On
# Library code, tests and runtime data are never reachable by URL.
RewriteRule ^(lib|tests|data)/ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Local configuration and runtime data must never be served.
<FilesMatch "^(config\.local\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>

# Basic browser hardening (only when the host has mod_headers).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
</IfModule>
