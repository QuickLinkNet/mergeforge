# SPA fallback for the built frontend. /api/ has its own .htaccess.
RewriteEngine On
# Plain http behind the host's proxy goes to https (only when the proxy says it was http).
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
