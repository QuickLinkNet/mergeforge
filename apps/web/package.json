{
  "name": "@mergeforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js",
    "build": "pnpm run typecheck && node ../../node_modules/vite/bin/vite.js build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit --pretty false && node ../../node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit --pretty false",
    "test": "node ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@mergeforge/renderer-pixi": "workspace:*",
    "@mergeforge/worldgen": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependenciesMeta": {
    "@mergeforge/renderer-pixi": {
      "injected": true
    },
    "@mergeforge/worldgen": {
      "injected": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
