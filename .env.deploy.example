# Copy to ".env.deploy". That file is git-ignored and stays on your machine.
# Credentials come from the hosting panel for red-it.org.

FTP_HOST=ftp.red-it.org
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password
FTP_PORT=21
# true = FTPS (recommended). Set false only if the host offers plain FTP only.
FTP_SECURE=true

# The deploy script never touches anything outside this folder
# (the path must end in /mergeforge). On this host the docroot is below /html.
REMOTE_BASE_DIR=/html/apps/mergeforge

# Public address, used by the deploy summary and `npm run live:check`.
PUBLIC_URL=https://mergeforge.red-it.org
